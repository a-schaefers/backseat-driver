# Dev tooling only: TypeScript for type checking
node_modules/

# Written by Claude Code each time it loads the plugin from this folder
plugin/.claude-plugin/types/

# Worktrees that other Claude Code sessions make in this repository.
.claude/worktrees/

# The kernel's build: the PureScript compiler (fetched by pinned hash), spago's
# packages and the compiled modules. The bundle they make,
# plugin/hooks/kernel.js, is committed.
local/
kernel/.spago/
kernel/output/
# The license server's secrets and records, if ever made inside the repository.
license-server/*.pem
license-server/*.key
license-server/licenses.json
